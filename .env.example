# URL pública canônica (SEO, Open Graph, sitemap). Só usada no servidor.
# Na Vercel: Environment Variable → SITE_URL (Production + Preview).
# NÃO use o prefixo NEXT_PUBLIC_ — a Vercel bloqueia/avisa porque expõe no browser.
SITE_URL=https://consultoria-mcm.com.br

# Após deploy: force o recrawl do preview em
# https://developers.facebook.com/tools/debug/
# com a URL https://consultoria-mcm.com.br
# (WhatsApp/IG usam o cache do Facebook — imagem social está em /og.jpg)

# Opcional — App ID numérico do https://developers.facebook.com/
# Sem isso o Debugger avisa "fb:app_id ausente" (é aviso, não quebra o preview).
# FB_APP_ID=123456789012345
